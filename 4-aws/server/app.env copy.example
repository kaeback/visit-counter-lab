# deploy.sh 가 docker run --env-file 로 앱 컨테이너에 넘기는 값. 서버의 ~/app.env 로 복사해서 쓴다
# Supabase Connect 화면의 값을 따옴표 없이 넣는다. 주석은 줄 맨 앞에만 둔다
# JDBC 접속 주소. <풀러호스트> 에 Supabase 커넥션 풀러 호스트를 넣는다
SPRING_DATASOURCE_URL=jdbc:postgresql://<풀러호스트>:5432/postgres
# 풀러를 거칠 때는 사용자명이 postgres.<프로젝트REF> 형식이다
SPRING_DATASOURCE_USERNAME=postgres.<프로젝트REF>
# 데이터베이스 비밀번호
SPRING_DATASOURCE_PASSWORD=<비밀번호>
