#!/bin/bash
# 배포 키로 들어온 접속은 무엇을 요청하든 이 스크립트만 실행된다.
# 허용하는 것은 "~/deploy.sh <40자 커밋 해시>" 하나뿐이다.
set -euo pipefail                                # 실패·미정의 변수·파이프 중간 실패 시 즉시 종료한다
cmd="${SSH_ORIGINAL_COMMAND:-}"                  # SSH 클라이언트가 원래 실행하려던 명령(없으면 빈 문자열)
echo "$(date '+%F %T') $cmd" >> "$HOME/deploy-gate.log"  # 요청된 명령을 시각과 함께 기록한다(허용 여부와 무관)
re='^~/deploy\.sh ([0-9a-f]{40})$'               # 허용 형식: ~/deploy.sh + 공백 + 소문자 16진수 40자. 괄호는 해시를 캡처한다
if [[ "$cmd" =~ $re ]]; then                     # 명령이 형식과 정확히 일치하면
  exec "$HOME/deploy.sh" "${BASH_REMATCH[1]}"    # 캡처한 해시만 인자로 넘겨 deploy.sh 로 교체 실행한다(원래 문자열은 셸이 해석하지 않는다)
fi
echo "허용되지 않은 명령이다: $cmd" >&2          # 그 밖의 명령은 거부 메시지를 표준 오류로 보낸다
exit 1                                           # 실패로 종료한다
