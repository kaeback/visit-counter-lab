# deploy.sh 가 docker run --env-file 로 앱 컨테이너에 넘기는 값. cp service.env.example service.env 로 복사한다
# docker run --env-file 은 값 뒤의 # 을 주석으로 보지 않는다. 주석은 줄 맨 앞에만 둔다
# JDBC 접속 주소. dsa-mysql 은 같은 네트워크의 MySQL 컨테이너 이름, visitdb 는 데이터베이스 이름
SPRING_DATASOURCE_URL=jdbc:mysql://dsa-mysql:3306/visitdb
# DB 사용자명(docker-compose.yml 의 MYSQL_USER 와 같다)
SPRING_DATASOURCE_USERNAME=visituser
# DB 비밀번호. .env 의 MYSQL_PASSWORD 와 같아야 한다
SPRING_DATASOURCE_PASSWORD=change-me-user
